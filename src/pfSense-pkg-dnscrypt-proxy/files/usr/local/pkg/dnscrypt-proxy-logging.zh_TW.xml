	<name>dnscryptproxy</name>
	<title>服務: DNSCrypt Proxy</title>
	<shortcut_section>dnscrypt-proxy</shortcut_section>
	<configpath>installedpackages->dnscryptproxy->config</configpath>
	<addedit_string>[dnscrypt-proxy] 設定已儲存</addedit_string>
	<aftersaveredirect>/pkg_edit.php?xml=dnscrypt-proxy-logging.xml</aftersaveredirect>
	<include_file>/usr/local/pkg/dnscrypt-proxy.inc</include_file>
	<tabs>
		<tab>
			<text>一般設定</text>
			<url>/dnscrypt-proxy.php?page=general</url>
		</tab>
		<tab>
			<text>伺服器選擇</text>
			<url>/dnscrypt-proxy.php?page=servers</url>
		</tab>
		<tab>
			<text>快取與過濾</text>
			<url>/dnscrypt-proxy.php?page=cache</url>
		</tab>
		<tab>
			<text>日誌</text>
			<url>/dnscrypt-proxy.php?page=logging</url>
			<active/>
		</tab>
		<tab>
			<text>清單</text>
			<url>/dnscrypt-proxy.php?page=lists</url>
		</tab>
		<tab>
			<text>進階設定</text>
			<url>/dnscrypt-proxy.php?page=advanced</url>
		</tab>
		<tab>
			<text>查詢日誌</text>
			<url>/dnscrypt-proxy-querylog.php</url>
		</tab>
		<tab>
			<text>設定檔</text>
			<url>/dnscrypt-proxy-config.php</url>
		</tab>
	</tabs>
	<fields>
		<field>
			<name>日誌設定</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>日誌等級</fielddescr>
			<fieldname>log_level</fieldname>
			<description>日誌詳細程度。 Info is useful for troubleshooting; Notice is recommended for normal operation.</description>
			<type>select</type>
			<default_value>2</default_value>
			<options>
				<option><name>1 - 資訊（詳細）</name><value>1</value></option>
				<option><name>2 - 通知（預設）</name><value>2</value></option>
				<option><name>3 - 警告</name><value>3</value></option>
				<option><name>4 - 錯誤</name><value>4</value></option>
				<option><name>5 - 嚴重（最精簡）</name><value>5</value></option>
			</options>
		</field>
		<field>
			<fielddescr>日誌目的地</fielddescr>
			<fieldname>log_destination</fieldname>
			<description>日誌訊息的傳送位置。 Only one can be active at a time.</description>
			<type>select</type>
			<default_value>syslog</default_value>
			<options>
				<option><name>系統日誌（狀態 &gt; 系統日誌）</name><value>syslog</value></option>
				<option><name>日誌檔案</name><value>file</value></option>
			</options>
		</field>
		<field>
			<fielddescr>日誌檔案路徑</fielddescr>
			<fieldname>log_file</fieldname>
			<description>Path to log file. Only used when 日誌目的地 is set to "日誌檔案".</description>
			<type>input</type>
			<size>50</size>
		</field>
		<field>
			<name>查詢日誌記錄</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>啟用查詢日誌</fielddescr>
			<fieldname>query_log</fieldname>
			<description>將所有 DNS 查詢記錄到檔案 (can grow large quickly)</description>
			<type>checkbox</type>
		</field>
		<field>
			<fielddescr>查詢日誌檔案</fielddescr>
			<fieldname>query_log_file</fieldname>
			<description>Path to query log file. Default: /var/log/dnscrypt-proxy/query.log</description>
			<type>input</type>
			<size>50</size>
			<default_value>/var/log/dnscrypt-proxy/query.log</default_value>
		</field>
	</fields>
	<custom_php_after_form_command>
		dnscrypt_proxy_logging_after_form();
	</custom_php_after_form_command>
	<custom_php_resync_config_command>
		dnscrypt_proxy_sync();
	</custom_php_resync_config_command>
	<custom_php_validation_command>
		dnscrypt_proxy_validate($_POST, $input_errors);
	</custom_php_validation_command>
	<custom_add_php_command_late>
		dnscrypt_proxy_save_config_late();
	</custom_add_php_command_late>
</packagegui>
