	<name>dnscryptproxy</name>
	<title>服务: DNSCrypt Proxy</title>
	<shortcut_section>dnscrypt-proxy</shortcut_section>
	<configpath>installedpackages->dnscryptproxy->config</configpath>
	<addedit_string>[dnscrypt-proxy] 设置已保存</addedit_string>
	<aftersaveredirect>/pkg_edit.php?xml=dnscrypt-proxy-logging.xml</aftersaveredirect>
	<include_file>/usr/local/pkg/dnscrypt-proxy.inc</include_file>
	<tabs>
		<tab>
			<text>常规设置</text>
			<url>/dnscrypt-proxy.php?page=general</url>
		</tab>
		<tab>
			<text>服务器选择</text>
			<url>/dnscrypt-proxy.php?page=servers</url>
		</tab>
		<tab>
			<text>缓存与过滤</text>
			<url>/dnscrypt-proxy.php?page=cache</url>
		</tab>
		<tab>
			<text>日志</text>
			<url>/dnscrypt-proxy.php?page=logging</url>
			<active/>
		</tab>
		<tab>
			<text>列表</text>
			<url>/dnscrypt-proxy.php?page=lists</url>
		</tab>
		<tab>
			<text>高级设置</text>
			<url>/dnscrypt-proxy.php?page=advanced</url>
		</tab>
		<tab>
			<text>查询日志</text>
			<url>/dnscrypt-proxy-querylog.php</url>
		</tab>
		<tab>
			<text>配置</text>
			<url>/dnscrypt-proxy-config.php</url>
		</tab>
	</tabs>
	<fields>
		<field>
			<name>日志设置</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>日志级别</fielddescr>
			<fieldname>log_level</fieldname>
			<description>日志详细程度。 Info is useful for troubleshooting; Notice is recommended for normal operation.</description>
			<type>select</type>
			<default_value>2</default_value>
			<options>
				<option><name>1 - 信息（详细）</name><value>1</value></option>
				<option><name>2 - 通知（默认）</name><value>2</value></option>
				<option><name>3 - 警告</name><value>3</value></option>
				<option><name>4 - 错误</name><value>4</value></option>
				<option><name>5 - 严重（最简略）</name><value>5</value></option>
			</options>
		</field>
		<field>
			<fielddescr>日志目标</fielddescr>
			<fieldname>log_destination</fieldname>
			<description>日志消息的发送位置。 Only one can be active at a time.</description>
			<type>select</type>
			<default_value>syslog</default_value>
			<options>
				<option><name>系统日志（状态 &gt; 系统日志）</name><value>syslog</value></option>
				<option><name>日志文件</name><value>file</value></option>
			</options>
		</field>
		<field>
			<fielddescr>日志文件路径</fielddescr>
			<fieldname>log_file</fieldname>
			<description>Path to log file. Only used when 日志目标 is set to "日志文件".</description>
			<type>input</type>
			<size>50</size>
		</field>
		<field>
			<name>查询日志记录</name>
			<type>listtopic</type>
		</field>
		<field>
			<fielddescr>启用查询日志</fielddescr>
			<fieldname>query_log</fieldname>
			<description>将所有 DNS 查询记录到文件 (can grow large quickly)</description>
			<type>checkbox</type>
		</field>
		<field>
			<fielddescr>查询日志文件</fielddescr>
			<fieldname>query_log_file</fieldname>
			<description>Path to query log file. Default: /var/log/dnscrypt-proxy/query.log</description>
			<type>input</type>
			<size>50</size>
			<default_value>/var/log/dnscrypt-proxy/query.log</default_value>
		</field>
	</fields>
	<custom_php_after_form_command>
		dnscrypt_proxy_logging_after_form();
	</custom_php_after_form_command>
	<custom_php_resync_config_command>
		dnscrypt_proxy_sync();
	</custom_php_resync_config_command>
	<custom_php_validation_command>
		dnscrypt_proxy_validate($_POST, $input_errors);
	</custom_php_validation_command>
	<custom_add_php_command_late>
		dnscrypt_proxy_save_config_late();
	</custom_add_php_command_late>
</packagegui>
