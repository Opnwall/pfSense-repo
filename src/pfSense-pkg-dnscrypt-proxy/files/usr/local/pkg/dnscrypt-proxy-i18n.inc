			'This action cannot be undone.' => '此操作無法復原。',
		],
	];

	return $translations[$language] ?? [];
}

function dnscrypt_proxy_gettext($text, $language = null) {
	$translations = dnscrypt_proxy_translations($language);
	return $translations[$text] ?? $text;
}

function dnscrypt_proxy_start_translation() {
	if (dnscrypt_proxy_language() === 'en_US') {
		return;
	}
	$translations = dnscrypt_proxy_translations();
	uksort($translations, function ($a, $b) {
		return strlen($b) <=> strlen($a);
	});
	ob_start(function ($buffer) use ($translations) {
		return strtr($buffer, $translations);
	});
}
