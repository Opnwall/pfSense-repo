/*
 * Package-local translations for DNSCrypt Proxy.
 *
 * pfSense's pkg_edit.php does not pass package XML field labels/help text
 * through gettext(), so this package keeps its translations isolated from the
 * system pfSense.mo catalogue and ships pre-generated localized XML files.
 */

function dnscrypt_proxy_language() {
	global $g;

	$language = $g['language'] ?? 'en_US';
	if (stripos($language, 'zh_CN') === 0 || stripos($language, 'zh_Hans') === 0) {
		return 'zh_CN';
	}
	if (stripos($language, 'zh_TW') === 0 || stripos($language, 'zh_Hant') === 0 ||
	    stripos($language, 'zh_HK') === 0) {
		return 'zh_TW';
	}
	return 'en_US';
}

