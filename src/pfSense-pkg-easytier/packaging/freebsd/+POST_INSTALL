#!/bin/sh
set -eu

ABI="$(pkg config ABI 2>/dev/null || true)"
case "$ABI" in
	FreeBSD:15:amd64|FreeBSD:16:amd64) ;;
	*)
		echo "Unsupported ABI: ${ABI:-unknown}; expected FreeBSD:15:amd64 or FreeBSD:16:amd64" >&2
		exit 1
		;;
esac

mkdir -p /usr/local/etc/easytier /var/log
if [ ! -e /usr/local/etc/easytier/config.toml ]; then
	install -m 0600 /usr/local/share/pfSense-pkg-easytier/config.toml.sample /usr/local/etc/easytier/config.toml
fi
chmod 0600 /usr/local/etc/easytier/config.toml
touch /var/log/easytier.log
chmod 0600 /var/log/easytier.log

if command -v php >/dev/null 2>&1 && [ -f /etc/inc/pkg-utils.inc ]; then
	php <<'PHP'
<?php
require_once('/etc/inc/config.inc');
require_once('/etc/inc/pkg-utils.inc');
foreach (['menu', 'service', 'package'] as $type) {
	$entries = config_get_path("installedpackages/{$type}", []);
	$entries = array_values(array_filter($entries, fn($e) =>
		!(($type === 'menu' && ($e['name'] ?? '') === 'EasyTier') ||
		  ($type === 'service' && ($e['name'] ?? '') === 'easytier') ||
		  ($type === 'package' && (($e['internal_name'] ?? '') === 'easytier' || ($e['name'] ?? '') === 'EasyTier')))));
	config_set_path("installedpackages/{$type}", $entries);
}
install_package_xml('easytier');

// pfSense may launch packages through shellcmd rather than rcorder.
// Register one entry and preserve the startup commands of other packages.
$cmd = 'service easytier start';
$shellcmds = config_get_path('installedpackages/shellcmdsettings/config', []);
if (!is_array($shellcmds)) {
	$shellcmds = [];
}
$shellcmds = array_values(array_filter($shellcmds, fn($e) =>
	!is_array($e) || ($e['cmd'] ?? '') !== $cmd));
$shellcmds[] = ['cmd' => $cmd, 'cmdtype' => 'shellcmd', 'description' => 'Start EasyTier on boot'];
config_set_path('installedpackages/shellcmdsettings/config', $shellcmds);
if (file_exists('/usr/local/pkg/shellcmd.inc')) {
	require_once('/usr/local/pkg/shellcmd.inc');
	if (function_exists('shellcmd_sync_package')) {
		shellcmd_sync_package();
	}
} else {
	$system_shellcmds = config_get_path('system/shellcmd', []);
	if (!is_array($system_shellcmds)) {
		$system_shellcmds = [];
	}
	$system_shellcmds = array_values(array_filter($system_shellcmds, fn($e) => $e !== $cmd));
	$system_shellcmds[] = $cmd;
	config_set_path('system/shellcmd', $system_shellcmds);
}
write_config('Register EasyTier startup shellcmd');
PHP
fi

echo "EasyTier installed. Open VPN > EasyTier to configure and start it."
