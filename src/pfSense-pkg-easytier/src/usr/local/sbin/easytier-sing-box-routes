#!/bin/sh

# sing-box's FreeBSD TUN uses FIB 2022 for connections that bypass the TUN.
# EasyTier installs routes in FIB 0; mirror its interface networks, not a
# particular installation's IP address. EasyTier owns this helper so the
# packages can be installed and upgraded independently.
i=0
while ! /sbin/ifconfig easytier0 2>/dev/null | /usr/bin/grep -q 'inet '; do
    if [ "$i" -ge 30 ]; then
        /usr/bin/logger -t easytier-sing-box 'EasyTier IPv4 interface was not ready within 30 seconds'
        exit 1
    fi
    sleep 1
    i=$((i + 1))
done

# A fresh boot has only FIB 0 until sing-box creates its bypass FIB.
fib_count=$(/sbin/sysctl -n net.fibs) || exit 1
[ "$fib_count" -gt 2022 ] || exit 0

routes=$(/usr/bin/netstat -rn -F 0 -f inet) || exit 1
networks=$(printf '%s\n' "$routes" | /usr/bin/awk '
    $4 == "easytier0" && $1 ~ /^[0-9]+\./ && $1 ~ /\// { print $1 }
')
if [ -z "$networks" ]; then
    /usr/bin/logger -t easytier-sing-box 'No EasyTier IPv4 network routes found in FIB 0'
    exit 1
fi

for network in $networks; do
    /usr/sbin/setfib 2022 /sbin/route add -net "$network" -interface easytier0 >/dev/null 2>&1 ||
        /usr/sbin/setfib 2022 /sbin/route change -net "$network" -interface easytier0 >/dev/null 2>&1 || {
            /usr/bin/logger -t easytier-sing-box "Failed to restore $network in FIB 2022"
            exit 1
        }
done
/usr/bin/logger -t easytier-sing-box 'Restored EasyTier IPv4 network routes in FIB 2022'
